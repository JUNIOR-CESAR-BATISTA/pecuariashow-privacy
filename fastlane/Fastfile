# Envio da build para o TestFlight, rodando no runner macOS do GitHub.
#
# Tudo se resolve com a chave da App Store Connect: o certificado de
# distribuição e o perfil de provisionamento são criados na hora, sem Mac e
# sem precisar de nenhum aparelho cadastrado na conta - que é a pegadinha da
# assinatura automática, ela exige um iPhone registrado para gerar o perfil
# de desenvolvimento.
#
# Sobre revogar o certificado a cada envio: o certificado de distribuição só
# funciona junto com a chave privada que o gerou, e essa chave nasce e morre
# dentro do runner, que é descartado no fim do run. O certificado que fica
# registrado na conta da Apple é, portanto, inútil no run seguinte - ele
# apenas ocupa uma das duas vagas que a Apple permite. Por isso, antes de
# pedir um certificado novo, apagamos os antigos: são cascas sem chave.
# Isso não afeta nada já enviado, porque a Apple reassina com o certificado
# dela o que está no TestFlight e na App Store.

require "spaceship"

default_platform(:ios)

BUNDLE_ID = "br.com.novilhanutri.app".freeze
# O chaveiro é criado pelo workflow antes de chamar o fastlane, e o caminho
# precisa ser dito explicitamente: sem isso o certificado é instalado em um
# chaveiro e procurado em outro.
CHAVEIRO = File.expand_path("~/Library/Keychains/build.keychain-db").freeze
SENHA_CHAVEIRO = "ci".freeze

# Revoga os certificados de distribuição já registrados na conta. Nenhum deles
# tem mais serventia: a chave privada correspondente ficou no runner que os
# criou e foi destruída junto com ele.
def liberar_vagas_de_certificado(chave)
  begin
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**chave)
  rescue StandardError => erro
    # Caminho alternativo, caso o formato do hash mude entre versões do fastlane.
    UI.important("Token pelo hash não funcionou (#{erro.message}); tentando pelo arquivo da chave")
    Spaceship::ConnectAPI.auth(
      key_id: ENV.fetch("CHAVE_ID"),
      issuer_id: ENV.fetch("EMISSOR"),
      filepath: ENV.fetch("CHAVE_ARQUIVO")
    )
  end

  apagados = 0
  %w[DISTRIBUTION IOS_DISTRIBUTION].each do |tipo|
    begin
      certificados = Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: tipo })
    rescue StandardError => erro
      UI.important("Não deu para listar os certificados #{tipo}: #{erro.message}")
      next
    end

    certificados.each do |certificado|
      next unless certificado.certificate_type.to_s.include?("DISTRIBUTION")

      begin
        UI.important("Revogando o certificado #{certificado.id} (#{certificado.certificate_type}) para liberar a vaga")
        certificado.delete!
        apagados += 1
      rescue StandardError => erro
        UI.important("Não deu para revogar #{certificado.id}: #{erro.message}")
      end
    end
  end

  UI.message("Certificados de distribuição revogados: #{apagados}")
end

platform :ios do
  desc "Compila em Release, assina para distribuição e envia ao TestFlight"
  lane :beta do
    chave = app_store_connect_api_key(
      key_id: ENV.fetch("CHAVE_ID"),
      issuer_id: ENV.fetch("EMISSOR"),
      key_filepath: ENV.fetch("CHAVE_ARQUIVO"),
      duration: 1200,
      in_house: false
    )

    # Apaga os certificados de distribuição órfãos antes de pedir um novo,
    # senão a Apple recusa dizendo que o limite de dois foi atingido.
    liberar_vagas_de_certificado(chave)

    # Cria o certificado de distribuição desta build.
    get_certificates(
      api_key: chave,
      development: false,
      keychain_path: CHAVEIRO,
      keychain_password: SENHA_CHAVEIRO
    )

    # Libera a chave privada para o codesign usar sem abrir caixa de diálogo,
    # que em runner sem tela trava o build.
    sh("security set-key-partition-list -S apple-tool:,apple:,codesign: " \
       "-s -k '#{SENHA_CHAVEIRO}' '#{CHAVEIRO}' >/dev/null 2>&1 || true")

    # Mostra quais identidades ficaram utilizáveis, para o log dizer algo
    # quando a assinatura falhar adiante.
    sh("security find-identity -v -p codesigning '#{CHAVEIRO}' || true")

    # Registra o identificador no portal e cria o app no App Store Connect.
    # É idempotente: se já existirem, apenas segue.
    begin
      produce(
        api_key: chave,
        app_identifier: BUNDLE_ID,
        app_name: "NovilhaNutri",
        language: "Brazilian Portuguese",
        app_version: ENV.fetch("VERSAO"),
        sku: "novilhanutri",
        team_id: ENV.fetch("TIME")
      )
    rescue StandardError => erro
      UI.important("produce não criou nada novo (provavelmente já existe): #{erro.message}")
    end

    # Cria o perfil de distribuição. Tem que ser force: true, porque qualquer
    # perfil antigo aponta para um certificado que acabou de ser revogado.
    get_provisioning_profile(
      api_key: chave,
      app_identifier: BUNDLE_ID,
      development: false,
      force: true
    )

    perfil = lane_context[SharedValues::SIGH_NAME]
    UI.message("Perfil de provisionamento em uso: #{perfil}")

    build_app(
      project: "NovilhaNutri.xcodeproj",
      scheme: "NovilhaNutri",
      configuration: "Release",
      export_method: "app-store",
      export_team_id: ENV.fetch("TIME"),
      export_options: {
        provisioningProfiles: { BUNDLE_ID => perfil }
      },
      xcargs: [
        "CODE_SIGN_STYLE=Manual",
        "DEVELOPMENT_TEAM=#{ENV.fetch('TIME')}",
        "PROVISIONING_PROFILE_SPECIFIER='#{perfil}'",
        "MARKETING_VERSION=#{ENV.fetch('VERSAO')}",
        "CURRENT_PROJECT_VERSION=#{ENV.fetch('BUILD')}",
        "OTHER_CODE_SIGN_FLAGS='--keychain #{CHAVEIRO}'"
      ].join(" "),
      output_directory: "build",
      output_name: "NovilhaNutri.ipa"
    )

    upload_to_testflight(
      api_key: chave,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
