# Envio da build para o TestFlight, rodando no runner macOS do GitHub.
#
# Tudo se resolve com a chave da App Store Connect: o certificado de
# distribuição e o perfil de provisionamento são criados na hora, sem Mac e
# sem precisar de nenhum aparelho cadastrado na conta - que é a pegadinha da
# assinatura automática, ela exige um iPhone registrado para gerar o perfil
# de desenvolvimento.

default_platform(:ios)

BUNDLE_ID = "br.com.novilhanutri.app".freeze
# O chaveiro é criado pelo workflow antes de chamar o fastlane, e o caminho
# precisa ser dito explicitamente: sem isso o certificado é instalado em um
# chaveiro e procurado em outro.
CHAVEIRO = File.expand_path("~/Library/Keychains/build.keychain-db").freeze
SENHA_CHAVEIRO = "ci".freeze

platform :ios do
  desc "Compila em Release, assina para distribuição e envia ao TestFlight"
  lane :beta do
    chave = app_store_connect_api_key(
      key_id: ENV.fetch("CHAVE_ID"),
      issuer_id: ENV.fetch("EMISSOR"),
      key_filepath: ENV.fetch("CHAVE_ARQUIVO"),
      duration: 1200,
      in_house: false
    )

    # Cria ou reaproveita o certificado de distribuição da conta.
    get_certificates(
      api_key: chave,
      development: false,
      keychain_path: CHAVEIRO,
      keychain_password: SENHA_CHAVEIRO
    )

    # Libera a chave privada para o codesign usar sem abrir caixa de diálogo,
    # que em runner sem tela trava o build.
    sh("security set-key-partition-list -S apple-tool:,apple:,codesign: " \
       "-s -k '#{SENHA_CHAVEIRO}' '#{CHAVEIRO}' >/dev/null 2>&1 || true")

    # Mostra quais identidades ficaram utilizáveis, para o log dizer algo
    # quando a assinatura falhar adiante.
    sh("security find-identity -v -p codesigning '#{CHAVEIRO}' || true")

    # Registra o identificador no portal e cria o app no App Store Connect.
    # É idempotente: se já existirem, apenas segue.
    begin
      produce(
        api_key: chave,
        app_identifier: BUNDLE_ID,
        app_name: "NovilhaNutri",
        language: "Brazilian Portuguese",
        app_version: ENV.fetch("VERSAO"),
        sku: "novilhanutri",
        team_id: ENV.fetch("TIME")
      )
    rescue StandardError => erro
      UI.important("produce não criou nada novo (provavelmente já existe): #{erro.message}")
    end

    # Cria ou baixa o perfil de distribuição para a App Store.
    get_provisioning_profile(
      api_key: chave,
      app_identifier: BUNDLE_ID,
      development: false,
      force: false
    )

    perfil = lane_context[SharedValues::SIGH_NAME]
    UI.message("Perfil de provisionamento em uso: #{perfil}")

    build_app(
      project: "NovilhaNutri.xcodeproj",
      scheme: "NovilhaNutri",
      configuration: "Release",
      export_method: "app-store",
      export_team_id: ENV.fetch("TIME"),
      export_options: {
        provisioningProfiles: { BUNDLE_ID => perfil }
      },
      xcargs: [
        "CODE_SIGN_STYLE=Manual",
        "DEVELOPMENT_TEAM=#{ENV.fetch('TIME')}",
        "PROVISIONING_PROFILE_SPECIFIER='#{perfil}'",
        "MARKETING_VERSION=#{ENV.fetch('VERSAO')}",
        "CURRENT_PROJECT_VERSION=#{ENV.fetch('BUILD')}",
        "OTHER_CODE_SIGN_FLAGS='--keychain #{CHAVEIRO}'"
      ].join(" "),
      output_directory: "build",
      output_name: "NovilhaNutri.ipa"
    )

    upload_to_testflight(
      api_key: chave,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
